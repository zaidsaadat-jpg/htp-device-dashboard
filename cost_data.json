  "processFlow": {
    "stages": [
      { "id": "component-sourcing", "order": 1, "name": "Component Sourcing", "icon": "🔋", "costSharePct": 38.0, "location": "Global suppliers — China · South Korea · Japan", "leadTimeDays": "60–90 days", "drivers": ["Lithium cell pricing", "MCU lead time", "AMOLED panel supply", "Aluminium LME", "Component yield rate"], "process": "Lithium-ion cells, microcontrollers, PCB blanks, AMOLED/touchscreen modules, aluminium billet or polymer pellets, resistive or induction heating assemblies, and USB-C connectors are sourced from specialised suppliers.", "inputs": ["Li-ion cells", "MCU + BMS chips", "Display modules", "PCB blanks", "Aluminium billet / polymer pellets", "Heating elements"], "outputs": ["QC-approved component lots", "Supplier batch records"] },
      { "id": "pcb-smt", "order": 2, "name": "PCB Fabrication & SMT", "icon": "🔌", "costSharePct": 14.0, "location": "ODM facility — Shenzhen · Penang · Wrocław", "leadTimeDays": "5–10 days", "drivers": ["SMT line utilisation", "MCU placement yield", "AOI false-positive rate", "Reflow energy cost"], "process": "Bare PCBs are fabricated with copper traces and solder mask. In SMT, solder paste is stencil-printed onto pads, high-speed pick-and-place machines position the MCU, BMS, memory, and passives, and boards reflow through a multi-zone oven.", "inputs": ["PCB blanks", "MCU chips", "BMS ICs", "Passive components", "Solder paste", "Reflow energy"], "outputs": ["Assembled controller PCBs", "AOI pass/fail records"] },
      { "id": "heating-assembly", "order": 3, "name": "Heating Element Assembly", "icon": "🔥", "costSharePct": 7.0, "location": "ODM facility — clean room", "leadTimeDays": "3–5 days", "drivers": ["Coil winding precision", "Ceramic core quality", "Thermal calibration time", "Resistance tolerance"], "process": "The heating element — resistive coil with ceramic core (BAT glo, JTI Ploom) or induction coil plus susceptor design (PMI IQOS SMARTCORE) — is manufactured and calibrated.", "inputs": ["Copper wire", "Ceramic core", "Ferrite elements (induction)", "Amplifier circuit (induction)"], "outputs": ["Calibrated heating assemblies", "Thermal test certificates"] },
      { "id": "housing-fab", "order": 4, "name": "Housing Fabrication", "icon": "🏭", "costSharePct": 10.0, "location": "ODM facility — machining & moulding", "leadTimeDays": "7–12 days", "drivers": ["CNC cycle time", "Injection cycle time", "Mould tooling amortisation", "Dimensional yield"], "process": "Aluminium housings are CNC-machined from billet, deburred, and prepared for finishing. Polymer housings are injection-moulded in multi-cavity tools.", "inputs": ["Aluminium billet / polymer pellets", "Cutting tools", "Mould release agent"], "outputs": ["Unfinished housings", "Dimensional inspection reports"] },
      { "id": "finishing", "order": 5, "name": "Finishing & Surface Treatment", "icon": "✨", "costSharePct": 4.0, "location": "ODM facility — finishing line", "leadTimeDays": "3–5 days", "drivers": ["Anodizing tank temperature", "Dye concentration", "Bead blast media condition", "Laser power & speed", "Paint booth humidity", "Batch size (lot charge amortization)"], "process": "Aluminium housings are bead-blasted for surface preparation, then Type II anodized (clear or dyed) in sulphuric acid baths. Laser engraving adds logos and regulatory marks. Plastic housings are painted in a spray booth and cured. Each step has its own lot charge, machine time, and quality inspection gate.", "inputs": ["Unfinished housings", "Anodizing chemicals (sulphuric acid, dye)", "Glass bead media", "Paint / powder", "Laser consumables"], "outputs": ["Finished housings", "Anodizing certification", "Colour-match inspection records"] },
      { "id": "sub-assembly", "order": 6, "name": "Sub-Assembly", "icon": "⚙️", "costSharePct": 8.0, "location": "ODM facility — assembly line", "leadTimeDays": "3–5 days", "drivers": ["Battery pack wiring time", "BMS calibration", "PCB mount accuracy", "Connector insertion torque"], "process": "Battery cells are welded into a pack and wired to the BMS. The controller PCB is mounted into the housing, USB-C port and connectors are fixed at specified torque, and internal wiring is routed.", "inputs": ["Battery cells", "BMS board", "Controller PCB", "Housing", "Connectors", "Wiring harness"], "outputs": ["Electrically functional device core", "Interim test results"] },
      { "id": "final-assembly", "order": 7, "name": "Final Assembly", "icon": "🔧", "costSharePct": 7.0, "location": "ODM facility — assembly line", "leadTimeDays": "2–4 days", "drivers": ["Holder-charger mating tolerance", "Seal & gasket fitting time", "Lid mechanism actuation cycles", "Torque spec enforcement"], "process": "For two-piece devices, the holder and pocket charger are mated and the connection validated across 500 open/close cycles. Seals, gaskets, and lid mechanisms are fitted.", "inputs": ["Device core", "Charger module (2-piece only)", "Seals & gaskets", "Fasteners"], "outputs": ["Fully assembled device", "Mechanical validation records"] },
      { "id": "qc-testing", "order": 8, "name": "QC & Testing", "icon": "🔍", "costSharePct": 4.0, "location": "ODM facility — test cell", "leadTimeDays": "2–3 days", "drivers": ["Test station cycle time", "Yield loss rate", "Battery cycle test throughput", "Thermal chamber energy"], "process": "100% functional test: power-on, heating cycle to spec temperature, LED/display check, USB charging, and firmware validation. Sample-based destructive testing: drop test, thermal cycling, battery life.", "inputs": ["Assembled device", "Test firmware", "Thermal chamber energy", "Destructive sample allocation"], "outputs": ["QC-passed device", "Batch yield records", "Test certificates"] },
      { "id": "packaging", "order": 9, "name": "Packaging", "icon": "📦", "costSharePct": 3.0, "location": "ODM facility — packing line", "leadTimeDays": "1–2 days", "drivers": ["Retail box cost", "USB-C cable cost", "Manual printing", "Packing labour minutes"], "process": "Devices are wiped clean, firmware-version labelled, and placed into retail packaging with USB-C cable, multi-language manual, warranty card, and cleaning tool. Boxes are sealed with anti-tamper tape.", "inputs": ["QC-passed device", "Retail box", "USB-C cable", "Manual + warranty", "Cleaning tool"], "outputs": ["Retail-ready package (FOB ready)", "Pallet manifest"] },
      { "id": "margin", "order": 10, "name": "Factory Margin", "icon": "💰", "costSharePct": 8.0, "location": "ODM P&L", "leadTimeDays": "—", "drivers": ["Order volume and MOQ", "Negotiated markup percentage", "Overhead recovery rate", "Competitive ODM pressure"], "process": "The ODM's profit on the FOB price. Typically 10–18% for tier-1 ODMs, 8–12% for tier-2, and 6–10% for tier-3.", "inputs": ["—"], "outputs": ["FOB price (factory gate)"] }
    ]
  }
